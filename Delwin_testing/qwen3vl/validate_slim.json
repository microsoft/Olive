{
  "input_model": {
    "type": "HfModel",
    "model_path": "Qwen/Qwen3-VL-2B-Instruct"
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "gpu",
          "execution_providers": [
            "CUDAExecutionProvider"
          ]
        }
      ]
    }
  },
  "passes": {
    "mobius_build": {
      "type": "MobiusBuilder",
      "precision": "fp32"
    },
    "int4_quantize": {
      "type": "OnnxKQuantQuantization",
      "bits": 4,
      "block_size": 32,
      "save_as_external_data": true
    },
    "flatten": {
      "type": "CompositeToOnnxPackage"
    }
  },
  "evaluators": {
    "evaluator": {
      "type": "LMMSEvaluator",
      "tasks": [
        "ai2d_lite"
      ],
      "batch_size": 1,
      "max_new_tokens": 64,
      "max_length": 4096,
      "limit": 3,
      "log_samples": false,
      "fail_on_error": false,
      "output_path": "/home/t-delwinkim/lmms_ort_adapter/results/test_qwen3vl_HFinput.json",
      "hf_model_kwargs": {
        "device_map": "cuda"
      }
    }
  },
  "evaluator": "evaluator",
  "evaluate_input_model": true,
  "target": "local_system",
  "output_dir": "/home/t-delwinkim/lmms_ort_adapter/models/qwen3vl/int4_fp32build",
  "cache_dir": "/home/t-delwinkim/lmms_ort_adapter/cache/qwen3vl_shared",
  "no_artifacts": true,
  "clean_evaluation_cache": true
}