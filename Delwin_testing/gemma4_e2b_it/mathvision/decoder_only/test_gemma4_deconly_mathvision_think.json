{
    "input_model": {
        "type": "HfModel",
        "model_path": "google/gemma-4-E2B-it"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["CUDAExecutionProvider"]
                }
            ]
        }
    },
    "passes": {
        "mobius_build": {
            "type": "MobiusBuilder",
            "precision": "fp16"
        },
        "int4_quantize": {
            "type": "OnnxKQuantQuantization",
            "bits": 4,
            "block_size": 32,
            "save_as_external_data": true,
            "nodes_to_exclude": ["vision_encoder/*", "audio_encoder/*", "embedding/*"]
        },
        "flatten": {
            "type": "CompositeToOnnxPackage"
        }
    },
    "evaluators": {
        "evaluator": {
            "type": "LMMSEvaluator",
            "tasks": [
                "mathvision_test"
            ],
            "batch_size": 1,
            "max_new_tokens": 2048,
            "max_length": 8192,
            "limit": 100,
            "system_prompt": "<|think|>\nYou are a helpful assistant.",
            "log_samples": false,
            "ignore_stop_strings": ["\n\n"],
            "output_path": "/home/t-delwinkim/lmms_ort_adapter/results/test_gemma4_deconly_mathvision_think.json",
            "fail_on_error": false
        }
    },
    "evaluator": "evaluator",
    "evaluate_input_model": false,
    "target": "local_system",
    "output_dir": "/home/t-delwinkim/lmms_ort_adapter/models/gemma4_e2b/int4_decoder_only",
    "cache_dir": "/home/t-delwinkim/lmms_ort_adapter/cache/gemma4_e2b_shared",
    "clean_evaluation_cache": true,
    "no_artifacts": true
}
