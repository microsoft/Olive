{
  "input_model": {
    "type": "ONNXModel",
    "model_path": "C:/path/to/your_model.onnx"
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "npu", "execution_providers": [ "OpenVINOExecutionProvider" ] }
      ]
    }
  },
  "host": "local_system",
  "target": "local_system",
  "passes": {
    "ov_model_package": {
      "type": "OpenVINOModelPackage",
      "package_name": "my-model",
      "compile_flow": "aot",
      "compile_options": {
        "ep.context_embed_mode": "0",
        "ep.enable_weightless_ep_context_nodes": "1"
      },
      "session_options": {
        "ep.context_file_path": "model_ctx.onnx"
      },
      "provider_options": {
        "load_config": "{\"NPU\":{\"NPU_TILES\":3,\"NPU_COMPILER_TYPE\":\"PLUGIN\"}}"
      },
      "target_devices": [ "643E", "B03E" ]
    }
  },
  "engine": {
    "search_strategy": false,
    "evaluate_input_model": false,
    "no_artifacts": true,
    "output_dir": "C:/path/to/output"
  }
}
